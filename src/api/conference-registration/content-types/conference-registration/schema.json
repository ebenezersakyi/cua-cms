{
  "kind": "collectionType",
  "collectionName": "conference_registrations",
  "info": {
    "singularName": "conference-registration",
    "pluralName": "conference-registrations",
    "displayName": "Conference Registration",
    "description": "Store 24th CUA Educational & Biennial Conference registration submissions"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "gender": {
      "type": "enumeration",
      "enum": ["Male", "Female"],
      "required": true
    },
    "age": {
      "type": "integer",
      "min": 1,
      "max": 120
    },
    "phoneNumber": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "creditUnion": {
      "type": "string",
      "required": true
    },
    "chapter": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "expectations": {
      "type": "text"
    },
    "tshirtSize": {
      "type": "enumeration",
      "enum": ["S", "M", "L", "XL", "XXL", "XXXL"]
    },
    "dietaryRestrictions": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": ["Pending", "Confirmed", "Cancelled"],
      "default": "Pending"
    },
    "adminNotes": {
      "type": "text"
    }
  }
}
